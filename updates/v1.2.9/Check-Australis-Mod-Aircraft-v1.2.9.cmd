@echo off
setlocal DisableDelayedExpansion
title Australis Modded Aircraft Selection v1.2.9
set "AUSTRALIS_SELECTION_SELF=%~f0"
set "AUSTRALIS_SELECTION_MODE=Check"
set "AUSTRALIS_SELECTION_GAME=%~1"
set "AUSTRALIS_SELECTION_LOADORDER=%~2"
set "AUSTRALIS_SELECTION_BACKUP="
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop';try{$s=[IO.File]::ReadAllText($env:AUSTRALIS_SELECTION_SELF);$m=[regex]::Matches($s,'(?ms)^#__AUSTRALIS_AIRCRAFT_PS_BEGIN__\r?\n(?<code>.*?)^#__AUSTRALIS_AIRCRAFT_PS_END__\r?$');if($m.Count -ne 1){throw 'Patch launcher is truncated.'};& ([ScriptBlock]::Create($m[0].Groups['code'].Value))}catch{Write-Host ('[FAILED] '+$_.Exception.Message);exit 1}"
set "AUSTRALIS_SELECTION_RESULT=%errorlevel%"
echo.
if not defined AUSTRALIS_SELECTION_NO_PAUSE pause
exit /b %AUSTRALIS_SELECTION_RESULT%
#__AUSTRALIS_AIRCRAFT_PS_BEGIN__
$ErrorActionPreference='Stop'
Set-StrictMode -Version 2
$stage='';$transcribing=$false;$exitStatus=0
try {
 $downloads=Join-Path ([Environment]::GetFolderPath('UserProfile')) 'Downloads'
 [void][IO.Directory]::CreateDirectory($downloads)
 $log=Join-Path $downloads ('Australis-Mod-Aircraft-v1.2.9-'+(Get-Date -Format 'yyyyMMdd-HHmmss')+'-'+[Guid]::NewGuid().ToString('N').Substring(0,8)+'.log')
 Start-Transcript -LiteralPath $log -Force | Out-Null;$transcribing=$true
 $self=[IO.File]::ReadAllText($env:AUSTRALIS_SELECTION_SELF)
 $block=[regex]::Matches($self,'(?ms)^#__AUSTRALIS_AIRCRAFT_PAYLOAD_BEGIN__\r?\n(?<data>.*?)^#__AUSTRALIS_AIRCRAFT_PAYLOAD_END__\r?$')
 if($block.Count -ne 1){throw 'Embedded patch payload is missing or truncated.'}
 $bytes=[Convert]::FromBase64String($block[0].Groups['data'].Value)
 $h=[Security.Cryptography.SHA256]::Create()
 try{$actual=([BitConverter]::ToString($h.ComputeHash($bytes))).Replace('-','').ToLowerInvariant()}finally{$h.Dispose()}
 if($actual -ne '5c675afe3ab527bf5c06f5d691398fbf3bcd4288fa8e3d98b49f05f307e87be8'){throw 'Embedded patch payload hash verification failed.'}
 Write-Host '[0%] Australis modded aircraft selection patch v1.2.9 - verified payload'
 $stage=Join-Path $downloads ('.Australis-AircraftFix-'+[Guid]::NewGuid().ToString('N'))
 [void][IO.Directory]::CreateDirectory($stage)
 $zip=Join-Path $stage 'patch.zip';[IO.File]::WriteAllBytes($zip,$bytes)
 Add-Type -AssemblyName System.IO.Compression.FileSystem
 [IO.Compression.ZipFile]::ExtractToDirectory($zip,$stage)
 $parameters=@{Mode=$env:AUSTRALIS_SELECTION_MODE;GameDirectory=$env:AUSTRALIS_SELECTION_GAME;LoadOrderPath=$env:AUSTRALIS_SELECTION_LOADORDER;BackupDirectory=$env:AUSTRALIS_SELECTION_BACKUP}
 & (Join-Path $stage 'Apply-Mod-Aircraft.ps1') @parameters | Format-List
} catch {$exitStatus=1;Write-Host ('[FAILED] '+$_.Exception.Message)}
finally {
 if($stage -and [IO.Directory]::Exists($stage)){Remove-Item -LiteralPath $stage -Recurse -Force -ErrorAction SilentlyContinue}
 if($transcribing){Stop-Transcript | Out-Null;Write-Host ('[LOG] '+$log)}
}
exit $exitStatus
#__AUSTRALIS_AIRCRAFT_PS_END__
